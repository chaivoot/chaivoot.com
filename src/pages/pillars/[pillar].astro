---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Feed from '../../components/Feed.astro';
import LineCTA from '../../components/LineCTA.astro';
import { PILLARS, PILLAR_ORDER, type PillarId } from '../../lib/pillars';

export async function getStaticPaths() {
  return PILLAR_ORDER.map((id) => ({ params: { pillar: id } }));
}

const pillarId = Astro.params.pillar as PillarId;
const p = PILLARS[pillarId];

const posts = (await getCollection('blog', ({ data }) => !data.draft && (data.pillar === pillarId || data.alsoIn?.includes(pillarId))))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title={`${p.name} — chaivoot`} description={p.long}>
  <div class="fade-in">
    <div class="pillar-hero">
      <div class="pillar-hero-num">
        <span class="pillar-hero-stripe" style={`background:${p.ink}`}></span>{p.num}
      </div>
      <h1>{p.name}</h1>
      <p>{p.long}</p>
    </div>
    {posts.length === 0 ? (
      <p class="empty">ยังไม่มี post ใน pillar นี้</p>
    ) : (
      <Feed posts={posts} fixedPillar={pillarId} />
    )}
  </div>
  <LineCTA />
</BaseLayout>

<style>
  .empty { max-width: var(--w-feed); margin: 0 auto; padding: var(--s-5) var(--pad-x); color: var(--fg-muted); font-style: italic; }
</style>
