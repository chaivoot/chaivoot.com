---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ไม่พบหน้านี้ — chaivoot">
  <div class="notfound fade-in">
    <p class="notfound-code">404</p>
    <h1>ไม่พบหน้านี้</h1>
    <p class="lead">เนื้อหาที่คุณต้องการอ่านอาจจะไม่มีอยู่แล้ว</p>
    <p>หากสนใจ กดคลิกไปหน้า home หรือทำความรู้จักกันได้ที่หน้า about</p>

    <div class="notfound-ctas">
      <a class="btn btn-outline" href="/">กลับหน้า Home</a>
      <a class="btn btn-ghost" href="/about">ทำความรู้จักกัน →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--w-body);
    margin: 0 auto;
    padding: var(--s-7) var(--pad-x);
    text-align: center;
  }
  .notfound-code {
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg-muted);
    margin-bottom: var(--s-3);
    line-height: 1;
  }
  .notfound h1 {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin-bottom: var(--s-4);
  }
  .notfound p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--fg);
    margin-bottom: var(--s-3);
  }
  .notfound p.lead {
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    margin-bottom: var(--s-3);
  }
  .notfound-ctas {
    display: flex;
    gap: var(--s-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--s-6);
  }
</style>
