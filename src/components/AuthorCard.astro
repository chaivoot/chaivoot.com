---
import { SITE } from '../lib/site';
---
<div class="author">
  <img class="author-ava" src="/chaivoot-avatar.png" alt={SITE.authorName} width="56" height="56" />
  <div>
    <div class="author-name">{SITE.authorName}</div>
    <div class="author-bio">{SITE.authorBio}</div>
  </div>
  <a class="btn btn-line" href={SITE.lineUrl}>LINE</a>
</div>
