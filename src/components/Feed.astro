---
import PostRow from './PostRow.astro';
import { PILLARS, PILLAR_ORDER, type PillarId } from '../lib/pillars';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  fixedPillar?: PillarId;
}
const { posts, fixedPillar } = Astro.props;
---
<div class="feed-wrap fade-in">
  {!fixedPillar && (
    <div class="filters" data-feed-filters>
      <button type="button" class="pill on" data-filter="all">ทั้งหมด</button>
      {PILLAR_ORDER.map((id) => (
        <button type="button" class="pill" data-filter={id}>
          <span class="dot" style={`background:${PILLARS[id].ink}`}></span>
          {PILLARS[id].name}
        </button>
      ))}
    </div>
  )}
  <div class="feed" data-feed>
    {posts.map((post) => <PostRow post={post} />)}
  </div>
</div>

<script>
  function initFeedFilter() {
    const root = document.querySelector<HTMLElement>('[data-feed-filters]');
    const feed = document.querySelector<HTMLElement>('[data-feed]');
    if (!root || !feed) return;
    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLElement>('[data-filter]');
      if (!btn) return;
      const filter = btn.dataset.filter;
      if (!filter) return;
      root.querySelectorAll<HTMLElement>('.pill').forEach((p) => {
        p.classList.toggle('on', p === btn);
      });
      feed.querySelectorAll<HTMLElement>('.post-row').forEach((row) => {
        const show = filter === 'all' || row.dataset.pillar === filter;
        row.style.display = show ? '' : 'none';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeedFilter);
  } else {
    initFeedFilter();
  }
</script>
