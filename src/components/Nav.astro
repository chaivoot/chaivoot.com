---
import { SITE } from '../lib/site';
const path = Astro.url.pathname;
const onHome = path === '/' || path === '';
const onAbout = path === '/about' || path.startsWith('/about/');
const onCourse = path === '/ai-course' || path.startsWith('/ai-course/');
---
<nav class="nav">
  <a class="nav-wm" href="/">
    <img src="/logo-mark-light.svg" alt="" width="28" height="28" />
    <span>chaivoot</span>
  </a>
  <div class="nav-links">
    <a href="/" class:list={['nav-link', { active: onHome }]}>บันทึก</a>
    <a href="/about" class:list={['nav-link', { active: onAbout }]}>เกี่ยวกับผม</a>
    <a href="/ai-course" class:list={['nav-link', { active: onCourse }]}>คอร์ส AI</a>
    <a class="btn btn-line" href={SITE.lineUrl} target="_blank" rel="noopener">LINE</a>
  </div>
</nav>
