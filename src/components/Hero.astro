---
import { SITE } from '../lib/site';
---
<section class="hero fade-in">
  <h1>บันทึกของชายวัย 50 กับหมา 1 ตัว ที่สนใจ Longevity และธุรกิจ Amway</h1>
  <div class="hero-body">
    <img
      class="hero-photo"
      src="/chaivoot-hero.jpg"
      alt="ชัยวุฒิและมอมแมม"
      width="996"
      height="996"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-text">
      <p class="hero-sub">เขียนสิ่งที่คิด สิ่งที่ทำ สิ่งที่อยากจำไว้ — บางวันสั้น บางวันยาว ไม่มีตารางบังคับ</p>
      <div class="hero-ctas">
        <a class="btn btn-line" href={SITE.lineUrl} target="_blank" rel="noopener">LINE</a>
        <a class="btn btn-ig"   href={SITE.igUrl}   target="_blank" rel="noopener">Instagram</a>
        <a class="btn btn-fb"   href={SITE.fbUrl}   target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </div>
</section>
