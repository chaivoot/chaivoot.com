---
import PillarBadge from './PillarBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const dateStr = post.data.date.toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' });
const isNote = post.data.format === 'note';
---
<article class:list={['card', { note: isNote }]}>
  <div class="meta">
    <PillarBadge id={post.data.pillar} />
    <span class="dot">·</span>
    <time>{dateStr}</time>
  </div>
  {isNote ? (
    <a href={`/blog/${post.slug}`} class="note-body">{post.data.excerpt || post.data.title}</a>
  ) : (
    <a href={`/blog/${post.slug}`} class="article-link">
      <h2>{post.data.title}</h2>
      {post.data.excerpt && <p>{post.data.excerpt}</p>}
    </a>
  )}
</article>

<style>
  .card { padding: var(--s-5) 0; border-bottom: 1px solid var(--border-faint); }
  .card:last-child { border-bottom: 0; }
  .meta { display: flex; align-items: center; gap: var(--s-2); font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--fg-muted); margin-bottom: var(--s-2); flex-wrap: wrap; }
  .dot { color: var(--fg-faint); }
  .article-link { text-decoration: none; color: var(--fg); display: block; }
  .article-link:hover h2 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .article-link h2 { font-size: var(--fs-h3); font-weight: var(--fw-med); margin: 0 0 var(--s-2); line-height: var(--lh-tight); text-wrap: balance; }
  .article-link p { margin: 0; color: var(--fg-muted); font-size: var(--fs-md); line-height: var(--lh-snug); }
  .note-body { display: block; text-decoration: none; color: var(--fg); font-size: var(--fs-md); line-height: var(--lh-body); }
  .note-body:hover { color: var(--fg); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .card.note { background: var(--bg-alt); padding: var(--s-4) var(--s-5); border-radius: var(--r-md); border: 0; margin: var(--s-3) 0; }
</style>
