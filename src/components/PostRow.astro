---
import { PILLARS } from '../lib/pillars';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const p = PILLARS[post.data.pillar];
const isNote = post.data.format === 'note';
const dateStr = post.data.date.toLocaleDateString('th-TH', {
  year: 'numeric', month: 'short', day: 'numeric',
});
const href = `/blog/${post.slug}`;
const badgeStyle = isNote
  ? `background:${p.wash};color:${p.deep}`
  : `background:#F0EDE7;color:#6B6B6B`;
const dotStyle = `background:${p.ink}`;
---
<article class:list={['post-row', { note: isNote }]} data-pillar={post.data.pillar}>
  <div class="post-meta">
    <span class="badge" style={badgeStyle}>{isNote ? 'บันทึก' : 'บทความ'}</span>
    <span class="meta-dot" style={dotStyle}></span>
    <span>{p.name}</span>
    <span class="sep">·</span>
    <time datetime={post.data.date.toISOString()}>{dateStr}</time>
    {post.data.read && (
      <>
        <span class="sep">·</span>
        <span>อ่าน {post.data.read} นาที</span>
      </>
    )}
  </div>
  {isNote ? (
    <a class="row-link" href={href}>
      <p class="post-excerpt">{post.data.excerpt}</p>
    </a>
  ) : (
    <a class="row-link" href={href}>
      <h3 class="post-title">{post.data.title}</h3>
      {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
      <span class="post-more">อ่านต่อ</span>
    </a>
  )}
</article>
