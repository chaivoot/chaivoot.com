---
import BaseLayout from './BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import LineCTA from '../components/LineCTA.astro';
import PostRow from '../components/PostRow.astro';
import { PILLARS } from '../lib/pillars';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const p = PILLARS[post.data.pillar];
const dateStr = post.data.date.toLocaleDateString('th-TH', {
  year: 'numeric', month: 'short', day: 'numeric',
});
const isNote = post.data.format === 'note';
const dotStyle = `background:${p.ink}`;
const badgeStyle = isNote
  ? `background:${p.wash};color:${p.deep}`
  : `background:#F0EDE7;color:#6B6B6B`;

const all = await getCollection('blog', ({ data }) => !data.draft);
const related = all
  .filter((r) => r.slug !== post.slug && r.data.pillar === post.data.pillar)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---
<BaseLayout title={`${post.data.title} — chaivoot`} description={post.data.excerpt}>
  <a class="back-link" href="/">← กลับไปหน้าบันทึก</a>
  <article class="post-detail fade-in">
    <div class="post-meta">
      <span class="badge" style={badgeStyle}>{isNote ? 'บันทึก' : 'บทความ'}</span>
      <span class="meta-dot" style={dotStyle}></span>
      <span>{p.name}</span>
      <span class="sep">·</span>
      <time datetime={post.data.date.toISOString()}>{dateStr}</time>
      {post.data.read && (
        <>
          <span class="sep">·</span>
          <span>อ่าน {post.data.read} นาที</span>
        </>
      )}
    </div>
    <h1>{post.data.title}</h1>
    {post.data.excerpt && <p class="post-excerpt-lg">{post.data.excerpt}</p>}
    <div class="body">
      <slot />
    </div>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    )}
    <AuthorCard />
  </article>

  {related.length > 0 && (
    <>
      <div class="related-h">บันทึกที่เกี่ยวข้อง</div>
      <div class="related-list">
        {related.map((r) => <PostRow post={r} />)}
      </div>
    </>
  )}

  <LineCTA />
</BaseLayout>
