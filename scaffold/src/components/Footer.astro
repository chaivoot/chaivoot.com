---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot-wm">
    <img src="/logo-mark-light.svg" alt="" width="18" height="18" />
    <span>chaivoot</span>
  </div>
  <div class="foot-meta">© {year} · บันทึกของชายวัย 50</div>
</footer>

<style>
  .foot { display: flex; justify-content: space-between; align-items: center; padding: var(--s-6) var(--pad-x); border-top: 1px solid var(--border-faint); margin-top: var(--s-8); color: var(--fg-muted); font-size: var(--fs-sm); }
  .foot-wm { display: flex; align-items: center; gap: var(--s-2); color: var(--fg); font-weight: var(--fw-med); letter-spacing: var(--tracking-tight); }
</style>
