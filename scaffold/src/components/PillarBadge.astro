---
import { PILLARS, type PillarId } from '../lib/pillars';
interface Props { id: PillarId; }
const { id } = Astro.props;
const p = PILLARS[id];
---
<a href={`/pillars/${id}`} class="badge" data-pillar={id}>
  <span class="dot"></span>
  <span class="name">{p.name}</span>
</a>

<style>
  .badge { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--fg-muted); }
  .badge:hover .name { color: var(--fg); }
  .dot { width: 6px; height: 6px; border-radius: 50%; }
  [data-pillar="amway"] .dot { background: var(--p1-ink); }
  [data-pillar="longevity"] .dot { background: var(--p2-ink); }
  [data-pillar="dogs"] .dot { background: var(--p3-ink); }
</style>
